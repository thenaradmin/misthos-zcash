# Copy to .env (gitignored). Every var is required for chain commands;
# a missing one makes `payroll check-env` exit 1 with "<VAR> not configured".

# Only "testnet" is accepted. Mainnet is refused by the code.
ZCASH_NETWORK=testnet

# Testnet lightwalletd gRPC endpoint, must be https://.
# https://testnet.zec.rocks:443 is the host the recorded live runs used (2026-10-20,
# see README "Proven on testnet"). Left blank so you choose your own server on purpose.
ZCASH_LWD_URL=

# zingo-cli data dir of the employer (treasury) wallet. zingo-cli creates it; child wallets
# go in <dir>/children/, and `pay --two-step` holds <dir>/payroll.lock while it runs.
ZCASH_WALLET_DB=./data/employer-wallet

# Path to a built zingo-cli (wallet that talks to lightwalletd). Required for `payroll pay`.
ZCASH_WALLET_CLI=

# Employer UFVK (testnet, `uviewtest1...`) given to the accountant. Never a spending key.
ZCASH_AUDITOR_UFVK=

# CSV of 3 testnet recipients for `cargo test --test testnet -- --ignored`.
PAYROLL_TEST_CSV=

# Roster CSV (name,ua,amountZEC,memo; real testnet UAs) shown by `payroll serve`.
PAYROLL_ROSTER_CSV=

# Employer wallet BIP 39 mnemonic. Each employee's child wallet seed is derived from it
# (keyed BLAKE2b on the payout address) for `pay --two-step` and `export-proof`.
# Never printed. Never commit it.
PAYROLL_EMPLOYER_SEED=

# Testnet height child wallets are restored from on first use (at or before the first funding tx).
PAYROLL_CHILD_BIRTHDAY=

# Optional: per employee, how long `pay --two-step` retries step 2 waiting for funding to be
# spendable (default 1800). The countdown starts only after that employee's block delay ends.
PAYROLL_STEP2_TIMEOUT_SECS=

# Optional: random block delays for `pay --two-step` (defaults 2 and 6; min must be <= max).
# Payouts start a random number of blocks after the funding tx is mined, then each employee
# waits its own random number of blocks after the previous one.
PAYROLL_DELAY_MIN_BLOCKS=
PAYROLL_DELAY_MAX_BLOCKS=

# Optional: how long `pay --two-step` waits for the funding tx to be mined (default 3600).
PAYROLL_FUNDING_CONFIRM_TIMEOUT_SECS=

# Employer ed25519 signing key for `export-proof`. Set ONE of these. Never printed.
# Create a key file with `payroll keygen-signing .data/employer-signing.key` (mode 0600;
# group/other-readable files are refused) and publish the printed public key in docs/employer-pubkey.txt.
PAYROLL_EMPLOYER_SIGNING_KEY_FILE=
# or the 64-hex-char seed itself:
PAYROLL_EMPLOYER_SIGNING_KEY=

# Optional, for `verify-proof`: the employer public key you trust (hex). Default: docs/employer-pubkey.txt.
PAYROLL_EMPLOYER_PUBKEY=
