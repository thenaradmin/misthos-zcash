# Copy to .env (gitignored). Every var is required for chain commands;
# a missing one makes `payroll check-env` exit 1 with "<VAR> not configured".

# Only "testnet" is accepted. Mainnet is refused by the code.
ZCASH_NETWORK=testnet

# Testnet lightwalletd gRPC endpoint, must be https://.
# Deliberately left blank: confirm a live testnet host in the current Zcash docs
# before filling it in (CLAUDE.md suggests testnet.zec.rocks:443, which has NOT been verified yet).
ZCASH_LWD_URL=

# Path to the employer's zcash_client_sqlite wallet DB (created in M2).
ZCASH_WALLET_DB=./data/employer-wallet.sqlite
